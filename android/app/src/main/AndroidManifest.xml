<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to api.joinasr.io and nothing else. cleartext is not
         permitted (the default from API 28 up), so a misconfigured base URL
         fails loudly instead of sending a password over plain HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declared now that the setup screens ask for them and the enforcement
         loop is next. Usage access and overlay are special access: the
         manifest entry only makes the app eligible, and the person grants
         each one in a Settings screen. tools:ignore because the linter
         flags PACKAGE_USAGE_STATS as system-only, which is exactly why it
         is granted the way it is. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Steps, and only steps. Asked for the first time somebody chooses a
         walking activity (Figma 22) and never at launch, because it is not
         needed to run a challenge. It is needed to earn extra time, which
         is optional. maxSdkVersion is deliberately absent: this is a runtime
         permission from API 29 and an install-time one below, and the
         manifest entry is what makes either possible. No location, no
         activity history: the step counter is a number the sensor hub keeps
         and nothing here asks where it was kept. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- The enforcement loop runs as a foreground service. SPECIAL_USE is the
         type Android 14 requires for it: the other types describe things this
         is not (no media, no location, no sync), and the whole point is that
         the service must keep running while the person uses other apps.
         RECEIVE_BOOT_COMPLETED brings it back after a restart, without which
         rebooting the phone would be the way out of a commitment. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- From Android 11 an app sees almost nothing of what else is installed
         unless it says what it is looking for. The blunt answer,
         QUERY_ALL_PACKAGES, is a restricted permission Play grants by
         exception and refuses for most reasons, and asking for it here would
         be asking for far more than this app needs.

         These three declare exactly what the picker and the enforcement loop
         look at: apps with a launcher entry, which is the same set a
         launcher shows and what a person means by "my apps"; the home app
         and the settings app, which are looked up so they can be kept *out*
         of the picker: a person who can block Settings cannot revoke the
         permissions Asr runs on, and one who can block their launcher cannot
         reach any app at all. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>


    <application
        android:name=".AsrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Asr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The password reset link. The email carries
                 https://joinasr.io/reset/<token> and this is what opens it:
                 an App Link rather than a custom scheme, so a link that
                 arrives on a phone without the app still lands on a real
                 web page instead of an error. autoVerify makes Android
                 check /.well-known/assetlinks.json and open the app without
                 asking; until that file lists this app's signing
                 certificate, the link shows a chooser, which still works. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="joinasr.io"
                    android:pathPrefix="/reset/" />
                <!-- The witness invitation, shared through whatever the
                     person already uses to talk to their mother. -->
                <data
                    android:scheme="https"
                    android:host="joinasr.io"
                    android:pathPrefix="/w/" />
            </intent-filter>
        </activity>

        <!-- The block screen. Its own task and out of recents, so dismissing
             it cannot leave a stray Asr entry behind and returning to the
             blocked app does not resurrect the old one: the service launches
             a fresh one within the second. singleTask so a second block
             while one is up arrives at the existing instance rather than
             stacking another copy. -->
        <activity
            android:name=".enforcement.BlockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="io.joinasr.app.block"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.Asr" />

        <!-- Every notification in this product arrives here. exported is
             false and the intent filter is the one FCM dispatches to; the
             system binds it directly, so nothing else can. -->
        <service
            android:name=".push.AsrMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The channel alerts land on, so a notification arriving before
             the app has ever run still has one. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_protection" />

        <service
            android:name=".enforcement.EnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Enforces the daily app time limits the user set for themselves. The service must run while other apps are in the foreground, because that is precisely when a limit can be reached." />
        </service>

        <receiver
            android:name=".enforcement.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
