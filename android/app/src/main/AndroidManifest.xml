<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app talks to api.joinasr.io and nothing else. cleartext is not
         permitted (the default from API 28 up), so a misconfigured base URL
         fails loudly instead of sending a password over plain HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The enforcement permissions (PACKAGE_USAGE_STATS, SYSTEM_ALERT_WINDOW,
         POST_NOTIFICATIONS, the special-use foreground service) are declared
         when the service that needs them lands, not before: an APK that asks
         for usage access while doing nothing with it is what Play rejects. -->

    <application
        android:name=".AsrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Asr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
