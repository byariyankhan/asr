<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to api.joinasr.io and nothing else. cleartext is not
         permitted (the default from API 28 up), so a misconfigured base URL
         fails loudly instead of sending a password over plain HTTP. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Declared now that the setup screens ask for them and the enforcement
         loop is next. Usage access and overlay are special access: the
         manifest entry only makes the app eligible, and the person grants
         each one in a Settings screen. tools:ignore because the linter
         flags PACKAGE_USAGE_STATS as system-only, which is exactly why it
         is granted the way it is. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />


    <application
        android:name=".AsrApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Asr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Asr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
