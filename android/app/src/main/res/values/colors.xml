    <!-- The launcher icon's ground. The same near-black as the app, and the
         same colour the mark's eyes and folds are painted in: they are drawn
         over this layer rather than punched out of the one above. -->
    <color name="ic_launcher_background">#0A0A0A</color>
</resources>
