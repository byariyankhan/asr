<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only has to exist and not flash white
         before the first frame. The real palette arrives with the design
         system, from the Figma file. -->
    <style name="Theme.Asr" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
