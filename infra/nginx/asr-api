# /etc/nginx/sites-available/asr-api
# certbot --nginx -d api.joinasr.io   adds the ssl_* lines and the 80→443 redirect.
# server_name has to be the real hostname: certbot --nginx edits whichever
# server block claims the name it was asked for, and if none does it falls
# back to the default server -- which is how a run with .com still written
# here deployed Asr's certificate into Bookween's site file.
server {
    server_name api.joinasr.io;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    listen 80;
    listen [::]:80;
}
